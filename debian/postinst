#!/usr/bin/env bash
set -euo pipefail

# M-08: Create ktc-mail system user (no login, no home)
adduser --system --group --no-create-home --quiet ktc-mail 2>/dev/null || true
# Allow reading Let's Encrypt TLS certs (genuinely optional — ssl-cert group may not exist)
adduser ktc-mail ssl-cert 2>/dev/null || true

# Mail store owner. Dovecot's rendered config runs its mail processes as
# 'vmail' (maildir at /var/mail/%d/%n). The package MUST create this user
# or Dovecot fails to start ("User doesn't exist: vmail").
adduser --system --group --home /var/mail --quiet vmail 2>/dev/null || true
adduser vmail ktc-mail 2>/dev/null || true

# Dedicated unprivileged users for the mail helpers.
adduser --system --group --no-create-home --quiet olefy 2>/dev/null || true
adduser --system --group --no-create-home --quiet mta-sts 2>/dev/null || true
# mta-sts must read /etc/ktc-mail (0750 root:ktc-mail) for its config; join the group.
adduser mta-sts ktc-mail 2>/dev/null || true

# Create the KTC venv and install oletools (provides /opt/ktc-mail/venv/bin/olevba3
# for Olefy). oletools IS on PyPI; python3-oletools is NOT in Debian trixie, so apt
# cannot provide it. Olefy itself is vendored at /opt/ktc-mail/olefy/olefy.py.
# ponytail: offline PyPI => Olefy soft-fails (rspamd can't reach :10050); mail still flows.
if [[ ! -x /opt/ktc-mail/venv/bin/olevba3 ]]; then
    if python3 -m venv /opt/ktc-mail/venv 2>/dev/null; then
        /opt/ktc-mail/venv/bin/pip install --upgrade pip >/dev/null 2>&1 || true
        if ! /opt/ktc-mail/venv/bin/pip install oletools 2>&1; then
            echo "WARNING: failed to pip install oletools into /opt/ktc-mail/venv" >&2
            echo "  Olefy macro scanning will be unavailable until:" >&2
            echo "    /opt/ktc-mail/venv/bin/pip install oletools" >&2
        fi
    else
        echo "WARNING: failed to create venv at /opt/ktc-mail/venv (python3-venv missing?)" >&2
    fi
fi
# Olefy runs as unprivileged 'olefy'; venv + vendored script must be readable.
chown -R root:root /opt/ktc-mail/venv /opt/ktc-mail/olefy 2>/dev/null || true
chmod -R go+rX /opt/ktc-mail/venv /opt/ktc-mail/olefy 2>/dev/null || true

install -d -m 0750 -o root -g ktc-mail /etc/ktc-mail /etc/ktc-mail/dkim
install -d -m 0770 -o root -g ktc-mail /var/lib/ktc-mail
# Runtime dir on tmpfs (recreated at boot via tmpfiles.d/ktc-mail.conf)
install -d -m 0750 -o ktc-mail -g ktc-mail /run/ktc-mail
systemd-tmpfiles --create ktc-mail.conf 2>/dev/null || true
# Setup GUI and admin portal need root to write Postfix/Dovecot configs;
# rate-limiter and exporter use ktc-mail user.
systemctl daemon-reload
systemctl enable ktc-mail-setup.service ktc-mail-admin.service ktc-mail-firewall-monitor.timer ktc-mail-acme-renew.timer ktc-mail-backup.timer ktc-mail-exporter.timer ktc-mail-rate-limit.service ktc-mail-audit-export.timer ktc-mail-olefy.service ktc-mail-mta-sts.service
# Avoid a port 8461 clash if the apt package ships its own unit for the same daemon.
systemctl disable --now postfix-mta-sts-resolver.service 2>/dev/null || true
systemctl restart ktc-mail-setup.service

# Apply default SSH policy (key-only) if no custom config exists
if [[ ! -f /etc/ssh/sshd_config.d/ktc-mail.conf ]]; then
  /usr/bin/ktc-mail ssh apply 2>/dev/null || true
fi

# Load + enforce AppArmor role profiles (conditional — AppArmor may not be present).
# Profiles are named (ktc-mail.<role>) and attached per-unit via systemd
# AppArmorProfile=. If AppArmor tooling IS present we MUST load at least one
# profile; loading zero is a misconfiguration, not a no-op — fail loudly.
if command -v aa-enforce &>/dev/null; then
    loaded=0
    for prof in /etc/apparmor.d/ktc-mail.*; do
        [[ -f "$prof" ]] || continue
        name="$(basename "$prof")"
        if ! apparmor_parser -r "$prof" 2>&1; then
            echo "ERROR: apparmor_parser failed for $name" >&2
            exit 1
        fi
        if ! aa-enforce "$name" 2>&1; then
            echo "ERROR: aa-enforce $name failed — profile not enforcing" >&2
            exit 1
        fi
        echo "AppArmor: $name enforced"
        loaded=$((loaded + 1))
    done
    if [[ "$loaded" -eq 0 ]]; then
        echo "ERROR: AppArmor present but no ktc-mail profiles found in /etc/apparmor.d/ — confinement is OFF" >&2
        exit 1
    fi
elif command -v aa-complain &>/dev/null; then
    # If only complain mode tools are available, at least parse+load them.
    loaded=0
    for prof in /etc/apparmor.d/ktc-mail.*; do
        [[ -f "$prof" ]] || continue
        if ! apparmor_parser -r "$prof" 2>&1; then
            echo "ERROR: apparmor_parser failed for $(basename "$prof")" >&2
            exit 1
        fi
        loaded=$((loaded + 1))
    done
    if [[ "$loaded" -eq 0 ]]; then
        echo "ERROR: AppArmor present but no ktc-mail profiles found in /etc/apparmor.d/" >&2
        exit 1
    fi
fi

# Recommend unattended-upgrades package
if ! dpkg -l unattended-upgrades &>/dev/null 2>&1; then
    echo ""
    echo "  Recommendation: Install unattended-upgrades for automatic security updates."
    echo "    apt-get install unattended-upgrades"
    echo "  KTC Mail provides a config at /etc/apt/apt.conf.d/50ktc-mail-unattended-upgrades"
    echo ""
fi

cat <<'MSG'

╔═════════════════════════════════════════════════════════╗
║  KTC Mail setup GUI is available at                    ║
║                                                         ║
║     http://SERVER_IP:8080                                ║
║                                                         ║
║  Complete the DNS and TLS wizard before enabling         ║
║  production mail flow.                                   ║
║                                                         ║
║  Three things you need:                                  ║
║    1. Your domain (e.g. example.com)                     ║
║    2. Your DNS provider API key                          ║
║    3. Your admin email address                           ║
║                                                         ║
║  Everything else is auto-detected.                       ║
╚═════════════════════════════════════════════════════════╝
MSG
