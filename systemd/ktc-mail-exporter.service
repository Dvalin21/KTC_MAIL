[Unit]
Description=KTC Mail Prometheus metrics collector
Documentation=https://github.com/Dvalin21/KTC_MAIL
# Writes /var/lib/ktc-mail/metrics.prom (Prometheus text format).
# Scrape it with node_exporter's textfile collector — see
# /usr/share/ktc-mail/examples/node-exporter-ktc-mail.conf (opt-in).
After=network-online.target

[Service]
Type=oneshot
User=ktc-mail
Group=ktc-mail
ExecStart=/usr/bin/ktc-mail metrics collect
AppArmorProfile=ktc-mail.exporter
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/ktc-mail

[Install]
WantedBy=multi-user.target
