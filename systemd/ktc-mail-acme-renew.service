[Unit]
Description=KTC Mail ACME certificate renewal
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/ktc-mail acme renew
AppArmorProfile=ktc-mail.acme
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/ktc-mail /var/lib/ktc-mail /etc/letsencrypt

[Install]
WantedBy=multi-user.target
