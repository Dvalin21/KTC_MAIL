[Unit]
Description=KTC Mail audit-log export (syslog/SIEM)
Documentation=https://github.com/Dvalin21/KTC_MAIL
After=network-online.target

[Service]
Type=oneshot
User=ktc-mail
Group=ktc-mail
# Targets are supplied by the operator via a drop-in (do NOT set blank
# defaults here — they would override ambient config).  Create e.g.
#   /etc/systemd/system/ktc-mail-audit-export.service.d/10-target.conf
#   [Service]
#   Environment=KTC_SYSLOG_HOST=logs.example.com
#   Environment=KTC_SYSLOG_PORT=514
#   Environment=KTC_SYSLOG_TCP=1
#   Environment=KTC_SIEM_URL=https://siem.example.com/ingest
# With no targets set the unit is a safe no-op (forwards nothing).
# Environment=KTC_SYSLOG_HOST= KTC_SYSLOG_PORT=514 KTC_SYSLOG_TCP=0 KTC_SIEM_URL=
ExecStart=/usr/bin/ktc-mail audit export \
    --syslog-host ${KTC_SYSLOG_HOST} \
    --syslog-port ${KTC_SYSLOG_PORT} \
    --tcp ${KTC_SYSLOG_TCP} \
    --siem-url ${KTC_SIEM_URL}
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/ktc-mail
# Needs only the audit log (read) + the position sidecar (write).
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6
